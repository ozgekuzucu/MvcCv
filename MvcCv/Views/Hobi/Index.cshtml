@using MvcCv.Models.Entity
@model List<TBL_Hobilerim>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h2>Hobi Düzenleme Sayfası</h2>
<br />
<form method="post">
    @foreach (var item in Model)
    {
        <input type="text" id="title" name="Aciklama1" style="font-weight: bold; color: black; border: 2px solid gray; background: transparent;" value="@item.Aciklama1">
        <br /><br />
        <textarea rows="5" class="form-control" name="Aciklama2">@item.Aciklama2</textarea>
        <br />
    }
    <button class="btn btn-success">Güncelle</button>
</form>